{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "main/**/*.ts",
    "preload.ts",
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "renderer/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}